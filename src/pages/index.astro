---
import Layout from '../layouts/Layout.astro';
import { getProjects, getExperience } from '../lib/kv';
import type { Project, ExperienceEntry } from '../lib/types';

const kv = Astro.locals.runtime?.env?.PORTFOLIO_KV;
const projects: Project[] = (await getProjects(kv)).filter(p => p.visible).sort((a, b) => a.order - b.order);
const experience: ExperienceEntry[] = (await getExperience(kv)).sort((a, b) => a.order - b.order);

const activeCount = experience.filter(e => e.status === 'active').length;
const clearedCount = experience.filter(e => e.status === 'done').length;

const statusLabel: Record<string, string> = { active: 'ACTIVE', done: 'CLEARED', archive: 'ARCHIVED' };
---
<Layout>
  <!-- ============ PARALLAX SEASCAPE ============ -->
  <div class="seascape" aria-hidden="true">
    <div class="layer sky" data-speed="0.02"></div>
    <div class="layer sun-gear" data-speed="0.10"></div>
    <div class="layer clouds" data-speed="0.16">
      <span class="cloud c1"></span>
      <span class="cloud c2"></span>
      <span class="cloud c3"></span>
    </div>
    <div class="layer sea" data-speed="-0.04"></div>
    <div class="layer glints" data-speed="-0.10"></div>
    <div class="layer waves" data-speed="-0.14"></div>
    <div class="layer waves w2" data-speed="-0.22"></div>
    <div class="layer machinery" data-speed="-0.30">
      <span class="gearwheel" style="left:6%;"></span>
      <span class="gearwheel" style="left:30%;bottom:2px;"></span>
      <span class="gearwheel" style="left:62%;"></span>
      <span class="gearwheel" style="left:88%;bottom:2px;"></span>
    </div>
  </div>
  <div class="scrim" aria-hidden="true"></div>

  <div class="doc">

    <!-- ========== DOC HEADER ========== -->
    <header class="doc-header reveal">
      <div>
        <div class="crumb">PORTFOLIO · COASTAL EDITION &nbsp;·&nbsp; <span style="color:var(--sea-deep);">REV. 3</span></div>
        <h1>PORTAFOLIO&nbsp;SBAS — SEASIDE&nbsp;WORKSHOP</h1>
        <div class="sub">Pixel-art costero + un toque steampunk · Juan Sebastián Arboleda T.</div>
      </div>
      <div class="meta">
        <b>v 0.3 — COAST</b><br>
        <span><span class="led-dot brass"></span> PRESSURE <b style="color:var(--brass-dark);">2.4 bar</b></span><br>
        Render @ 1180px
      </div>
    </header>

    <!-- ================================================================ -->
    <!-- 1. HERO                                                           -->
    <!-- ================================================================ -->
    <section class="block reveal">
      <div class="block-head">
        <span class="num">01 ›</span>
        <h2>PLAYER&nbsp;1 — SET SAIL</h2>
        <span class="tag">DECK&nbsp;01 / 04</span>
      </div>

      <div class="hero riveted">
        <span class="rivet tl"></span><span class="rivet tr"></span>
        <span class="rivet bl"></span><span class="rivet br"></span>

        <div class="hero-floaters">
          <span style="top:16%;left:60%;">+100 XP</span>
          <span style="top:66%;left:52%;color:var(--coral);">★</span>
          <span style="top:28%;left:90%;color:var(--sea);">◆</span>
        </div>

        <div class="topbar">
          <div class="left">
            <span class="gauge"><span class="led-dot"></span> SYS: ONLINE</span>
            <span class="gauge">⚓ MEDELLÍN, CO</span>
            <span class="gauge">CLK <b>3.6GHz</b></span>
          </div>
          <div class="right">
            <span class="gauge brass">STEAM <b>2.4 bar</b></span>
            <span class="gauge brass">TEMP <b>42°C</b></span>
            <span class="gauge"><span class="heart"></span><span class="heart"></span><span class="heart"></span></span>
          </div>
        </div>

        <div class="hero-row">
          <div>
            <div class="ready">PLAYER&nbsp;1 READY</div>
            <h1 class="name">SEBAS<br>ARBOLEDA.</h1>
            <div class="role">
              Software Developer <span class="pipe">·</span> SysAdmin <span class="pipe">·</span>
              Mecatrónica · React · DevOps
            </div>

            <div class="reg">
              <span class="led-dot sea"></span>
              <span>&gt; ./set_sail --stack=fullstack &amp;&amp; build(ideas)</span>
            </div>

            <div class="stats">
              <div><b>08</b>AÑOS DE XP</div>
              <div><b>15+</b>QUESTS</div>
              <div><b>11</b>CERTS</div>
              <div><b>03</b>IDIOMAS</div>
            </div>

            <div class="cta-row">
              <button class="pxbtn" onclick="document.getElementById('sec-contact').scrollIntoView({behavior:'smooth'})">
                ZARPAR <span class="arrow">▶</span>
              </button>
              <button class="pxbtn ghost" onclick="document.getElementById('sec-experience').scrollIntoView({behavior:'smooth'})">
                [ VER BITÁCORA ]
              </button>
              <span class="blink">★ INSERT COIN</span>
            </div>
          </div>

          <!-- Pixel avatar inside a brass porthole -->
          <div class="avatar-wrap">
            <div class="porthole">
              <span class="pr" style="top:8px;left:50%;margin-left:-4px;"></span>
              <span class="pr" style="bottom:8px;left:50%;margin-left:-4px;"></span>
              <span class="pr" style="left:8px;top:50%;margin-top:-4px;"></span>
              <span class="pr" style="right:8px;top:50%;margin-top:-4px;"></span>
              <div class="avatar">
                <!-- row 1 --><i class="x"></i><i class="x"></i><i class="x"></i><i class="x"></i><i class="k"></i><i class="k"></i><i class="k"></i><i class="k"></i><i class="k"></i><i class="k"></i><i class="x"></i><i class="x"></i><i class="x"></i><i class="x"></i>
                <!-- row 2 --><i class="x"></i><i class="x"></i><i class="x"></i><i class="k"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="k"></i><i class="x"></i><i class="x"></i><i class="x"></i>
                <!-- row 3 --><i class="x"></i><i class="x"></i><i class="k"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="k"></i><i class="x"></i><i class="x"></i>
                <!-- row 4 --><i class="x"></i><i class="k"></i><i class="h"></i><i class="h"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="h"></i><i class="h"></i><i class="k"></i><i class="x"></i>
                <!-- row 5 --><i class="x"></i><i class="k"></i><i class="h"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="h"></i><i class="k"></i><i class="x"></i>
                <!-- row 6 --><i class="x"></i><i class="k"></i><i class="s"></i><i class="s"></i><i class="e"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="e"></i><i class="s"></i><i class="s"></i><i class="k"></i><i class="x"></i>
                <!-- row 7 --><i class="x"></i><i class="k"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="k"></i><i class="x"></i>
                <!-- row 8 --><i class="x"></i><i class="k"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="e"></i><i class="e"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="k"></i><i class="x"></i>
                <!-- row 9 --><i class="x"></i><i class="x"></i><i class="k"></i><i class="sd"></i><i class="sd"></i><i class="sd"></i><i class="sd"></i><i class="sd"></i><i class="sd"></i><i class="sd"></i><i class="sd"></i><i class="k"></i><i class="x"></i><i class="x"></i>
                <!-- row 10 --><i class="x"></i><i class="k"></i><i class="j"></i><i class="j"></i><i class="c"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="c"></i><i class="j"></i><i class="j"></i><i class="k"></i><i class="x"></i>
                <!-- row 11 --><i class="k"></i><i class="j"></i><i class="j"></i><i class="j"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="j"></i><i class="j"></i><i class="j"></i><i class="k"></i>
                <!-- row 12 --><i class="k"></i><i class="j"></i><i class="jd"></i><i class="j"></i><i class="w"></i><i class="c"></i><i class="c"></i><i class="c"></i><i class="c"></i><i class="w"></i><i class="j"></i><i class="jd"></i><i class="j"></i><i class="k"></i>
                <!-- row 13 --><i class="k"></i><i class="j"></i><i class="jd"></i><i class="j"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="j"></i><i class="jd"></i><i class="j"></i><i class="k"></i>
                <!-- row 14 --><i class="k"></i><i class="j"></i><i class="jd"></i><i class="j"></i><i class="j"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="j"></i><i class="j"></i><i class="jd"></i><i class="j"></i><i class="k"></i>
                <!-- row 15 --><i class="x"></i><i class="k"></i><i class="j"></i><i class="j"></i><i class="k"></i><i class="x"></i><i class="x"></i><i class="x"></i><i class="x"></i><i class="k"></i><i class="j"></i><i class="j"></i><i class="k"></i><i class="x"></i>
                <!-- row 16 --><i class="x"></i><i class="k"></i><i class="k"></i><i class="k"></i><i class="x"></i><i class="x"></i><i class="x"></i><i class="x"></i><i class="x"></i><i class="x"></i><i class="k"></i><i class="k"></i><i class="k"></i><i class="x"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================ -->
    <!-- 2. EXPERIENCE                                                     -->
    <!-- ================================================================ -->
    <section class="block reveal" id="sec-experience">
      <div class="block-head">
        <span class="num">02 ›</span>
        <h2>LEVEL&nbsp;UP — BITÁCORA (EXPERIENCIA)</h2>
        <span class="tag">DECK&nbsp;02 / 04</span>
      </div>

      <div class="logbook riveted">
        <span class="rivet tl"></span><span class="rivet tr"></span>
        <span class="rivet bl"></span><span class="rivet br"></span>
        <div class="logbook-head">
          <h3>SHIP'S LOG</h3>
          <div class="filter">
            <span class="on">ALL · {experience.length.toString().padStart(2, '0')}</span>
            <span>ACTIVE · {activeCount.toString().padStart(2, '0')}</span>
            <span>CLEARED · {clearedCount.toString().padStart(2, '0')}</span>
          </div>
        </div>

        <div class="log-list">
          {experience.map((entry) => (
            <div class:list={['log-row', entry.status === 'active' ? 'active' : '']}>
              <div class="lvl">{entry.lvl}</div>
              <div class="role">
                {entry.role}
                <small>{entry.subrole}</small>
              </div>
              <div class="company">{entry.company}</div>
              <div class="dates">{entry.dates}</div>
              <div class:list={['status', entry.status === 'done' ? 'done' : '', entry.status === 'archive' ? 'archive' : '']}>
                {statusLabel[entry.status] ?? entry.status}
              </div>
            </div>
          ))}
        </div>

        <div class="depth">
          <span class="lab"><span class="led-dot sea"></span> DEPTH</span>
          <div class="bar"></div>
          <span class="num">8 200 / 10 000 ▲ LVL 9</span>
        </div>
      </div>
    </section>

    <!-- ================================================================ -->
    <!-- 3. PROJECTS                                                       -->
    <!-- ================================================================ -->
    <section class="block reveal" id="sec-projects">
      <div class="block-head">
        <span class="num">03 ›</span>
        <h2>CARGO&nbsp;HOLD — PROYECTOS</h2>
        <span class="tag">DECK&nbsp;03 / 04</span>
      </div>

      <div class="cargo riveted">
        <span class="rivet tl"></span><span class="rivet tr"></span>
        <span class="rivet bl"></span><span class="rivet br"></span>
        <div class="cargo-grid">
          {projects.map((proj) => (
            <button class="manifest" data-proj={proj.id}>
              <div class="emblem" style={proj.emblemStyle || ''}>
                <span class="ring"></span>
                <span class="tagno">CARGO·{proj.no}</span>
              </div>
              <div class="body">
                <div class="kicker">
                  {proj.kicker} <span class="yr">· {proj.year}</span>
                </div>
                <h4>{proj.title}</h4>
                <p class="one">{proj.oneliner}</p>
                <div class="foot">
                  <div class="chips">
                    {proj.stack.slice(0, 3).map(([name, cls]) => (
                      <span class:list={['chip', cls]}>{name}</span>
                    ))}
                  </div>
                  <span class="open">VER ▸</span>
                </div>
              </div>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- ================================================================ -->
    <!-- 4. CONTACT                                                        -->
    <!-- ================================================================ -->
    <section class="block reveal" id="sec-contact" style="margin-bottom:24px;">
      <div class="block-head">
        <span class="num">04 ›</span>
        <h2>CONTINUE? — DROP ANCHOR (CONTACTO)</h2>
        <span class="tag">DECK&nbsp;04 / 04</span>
      </div>

      <div class="anchor riveted">
        <span class="rivet tl"></span><span class="rivet tr"></span>
        <span class="rivet bl"></span><span class="rivet br"></span>
        <div class="big">DROP ANCHOR</div>
        <div class="prompt">CONTINUE? &nbsp; YES / NO</div>
        <div class="reg">⚙ ping sebastian — awaiting handshake · 0xC0FFEE ⚙</div>

        <div class="links">
          <a class="link gh" href="https://github.com/Sbas0611" target="_blank" rel="noopener">
            <div class="icn"></div>
            <h5>GITHUB</h5>
            <p>github.com/Sbas0611</p>
          </a>
          <a class="link li" href="https://www.linkedin.com/in/sebastián-arboleda" target="_blank" rel="noopener">
            <div class="icn"></div>
            <h5>LINKEDIN</h5>
            <p>in/sebastián-arboleda</p>
          </a>
          <a class="link ml" href="mailto:dev.arboleda@gmail.com">
            <div class="icn"></div>
            <h5>EMAIL</h5>
            <p>dev.arboleda@gmail.com</p>
          </a>
        </div>

        <div style="display:flex;justify-content:center;gap:14px;flex-wrap:wrap;">
          <a href="mailto:dev.arboleda@gmail.com" class="pxbtn">▶ YES — CONTÁCTAME</a>
          <button class="pxbtn ghost" onclick="window.scrollTo({top:0,behavior:'smooth'})">
            [ NO · VOLVER ARRIBA ]
          </button>
        </div>

        <div class="footer-bar">
          <span>© 2026 SBAS.DEV &nbsp;·&nbsp; MADE IN MEDELLÍN</span>
          <span>PRESS <b>ESC</b> TO QUIT &nbsp;·&nbsp; <b>↑↑↓↓←→←→BA</b></span>
        </div>
      </div>
    </section>

  </div>

  <!-- ============ PROJECT SHEET ============ -->
  <div class="sheet-backdrop" id="sheet-backdrop"></div>
  <div class="sheet" id="proj-sheet" role="dialog" aria-modal="true" aria-label="Detalle del proyecto"></div>

  <!-- Inject project data for client-side sheet -->
  <script type="application/json" id="portfolio-data" is:inline set:html={JSON.stringify({ projects })} />

  <script src="/portfolio.js" is:inline></script>
</Layout>
