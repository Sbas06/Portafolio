---
import Layout from '../layouts/Layout.astro';
import { getProjects, getExperience, getAbout, getContact } from '../lib/kv';
import type { Project, ExperienceEntry } from '../lib/types';

const kv = Astro.locals.runtime?.env?.PORTFOLIO_KV;
const projects: Project[] = (await getProjects(kv)).filter(p => p.visible).sort((a, b) => a.order - b.order);
const experience: ExperienceEntry[] = (await getExperience(kv)).sort((a, b) => a.order - b.order);
const about = await getAbout(kv);
const contact = await getContact(kv);

const activeCount = experience.filter(e => e.status === 'active').length;
const clearedCount = experience.filter(e => e.status === 'done').length;
const statusLabel: Record<string, string> = { active: 'ACTIVE', done: 'CLEARED', archive: 'ARCHIVED' };
---
<Layout>
  <!-- ============ PARALLAX SEASCAPE (fixed, behind) ============ -->
  <div class="seascape" aria-hidden="true">
    <div class="layer sky" data-speed="0.02"></div>
    <div class="layer sun-gear" data-speed="0.10"></div>
    <div class="layer clouds" data-speed="0.16">
      <span class="cloud c1"></span>
      <span class="cloud c2"></span>
      <span class="cloud c3"></span>
    </div>
    <div class="layer sea" data-speed="-0.04"></div>
    <div class="layer glints" data-speed="-0.10"></div>
    <div class="layer waves" data-speed="-0.14"></div>
    <div class="layer waves w2" data-speed="-0.22"></div>
    <div class="layer machinery" data-speed="-0.30">
      <span class="gearwheel" style="left:6%;"></span>
      <span class="gearwheel" style="left:30%;bottom:2px;"></span>
      <span class="gearwheel" style="left:62%;"></span>
      <span class="gearwheel" style="left:88%;bottom:2px;"></span>
    </div>
  </div>
  <div class="scrim" aria-hidden="true"></div>

  <!-- ============ TOPNAV ============ -->
  <header class="topnav">
    <a class="brand" href="#home"><span class="cog"></span> SBAS<b>.DEV</b></a>
    <button class="nav-toggle" aria-label="Menú">&#x2261;</button>
    <nav id="topnav-menu">
      <a href="#home"><span class="n">01</span> INICIO</a>
      <a href="#experiencia"><span class="n">02</span> EXPERIENCIA</a>
      <a href="#proyectos"><span class="n">03</span> PROYECTOS</a>
      <a href="#about"><span class="n">04</span> SOBRE MÍ</a>
      <a href="#contacto" class="navcta"><span class="n">05</span> CONTACTO</a>
    </nav>
  </header>

  <!-- ============ SECTION NAV (fixed dots on right) ============ -->
  <nav class="section-nav" aria-label="Secciones">
    <a href="#home"        class="snav-dot" data-target="home"        aria-label="Inicio"></a>
    <a href="#experiencia" class="snav-dot" data-target="experiencia" aria-label="Experiencia"></a>
    <a href="#proyectos"   class="snav-dot" data-target="proyectos"   aria-label="Proyectos"></a>
    <a href="#about"       class="snav-dot" data-target="about"       aria-label="Sobre Mí"></a>
    <a href="#contacto"    class="snav-dot" data-target="contacto"    aria-label="Contacto"></a>
  </nav>

  <main class="site">

    <!-- ============================================================ -->
    <!-- 1. HERO                                                       -->
    <!-- ============================================================ -->
    <section class="screen hero-screen" id="home">
      <div class="shell">
        <div class="year-mark" aria-hidden="true"><span>20</span><span>26</span></div>

        <div class="hero riveted">
          <span class="rivet tl"></span><span class="rivet tr"></span>
          <span class="rivet bl"></span><span class="rivet br"></span>

          <div class="hero-floaters">
            <span style="top:16%;left:60%;">+100 XP</span>
            <span style="top:66%;left:52%;color:var(--coral);">★</span>
            <span style="top:28%;left:90%;color:var(--sea);">◆</span>
          </div>

          <div class="topbar">
            <div class="left">
              <span class="gauge"><span class="led-dot"></span> SYS: ONLINE</span>
              <span class="gauge">⚓ MEDELLÍN, CO</span>
              <span class="gauge">CLK <b>3.6GHz</b></span>
            </div>
            <div class="right">
              <span class="gauge brass">STEAM <b>2.4 bar</b></span>
              <span class="gauge brass">TEMP <b>42°C</b></span>
              <span class="gauge"><span class="heart"></span><span class="heart"></span><span class="heart"></span></span>
            </div>
          </div>

          <div class="hero-row">
            <div>
              <div class="ready">PORTFOLIO&nbsp;· 2026</div>
              <h1 class="name">SEBAS<br>ARBOLEDA.</h1>
              <div class="role">
                Software Developer <span class="pipe">·</span> SysAdmin <span class="pipe">·</span>
                Mecatrónica · React · DevOps
              </div>
              <div class="reg">
                <span class="led-dot sea"></span>
                <span>&gt; ./set_sail --stack=fullstack &amp;&amp; build(ideas)</span>
              </div>
              <div class="stats">
                <div><b>08</b>AÑOS DE XP</div>
                <div><b>15+</b>QUESTS</div>
                <div><b>11</b>CERTS</div>
                <div><b>03</b>IDIOMAS</div>
              </div>
              <div class="cta-row">
                <a class="pxbtn" href="#proyectos">VER PROYECTOS <span class="arrow">▶</span></a>
                <a class="pxbtn ghost" href="#contacto">[ CONTÁCTAME ]</a>
              </div>
            </div>

            <div class="avatar-wrap">
              <div class="porthole">
                <span class="pr" style="top:8px;left:50%;margin-left:-4px;"></span>
                <span class="pr" style="bottom:8px;left:50%;margin-left:-4px;"></span>
                <span class="pr" style="left:8px;top:50%;margin-top:-4px;"></span>
                <span class="pr" style="right:8px;top:50%;margin-top:-4px;"></span>
                <div class="avatar">
                  <i class="x"></i><i class="x"></i><i class="x"></i><i class="k"></i><i class="k"></i><i class="k"></i><i class="k"></i><i class="k"></i><i class="k"></i><i class="x"></i><i class="x"></i><i class="x"></i><i class="x"></i><i class="x"></i>
                  <i class="x"></i><i class="x"></i><i class="x"></i><i class="k"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="k"></i><i class="x"></i><i class="x"></i><i class="x"></i>
                  <i class="x"></i><i class="x"></i><i class="k"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="h"></i><i class="k"></i><i class="x"></i><i class="x"></i>
                  <i class="x"></i><i class="k"></i><i class="h"></i><i class="h"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="h"></i><i class="h"></i><i class="k"></i><i class="x"></i>
                  <i class="x"></i><i class="k"></i><i class="h"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="h"></i><i class="k"></i><i class="x"></i>
                  <i class="x"></i><i class="k"></i><i class="s"></i><i class="s"></i><i class="e"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="e"></i><i class="s"></i><i class="s"></i><i class="k"></i><i class="x"></i>
                  <i class="x"></i><i class="k"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="k"></i><i class="x"></i>
                  <i class="x"></i><i class="k"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="e"></i><i class="e"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="s"></i><i class="k"></i><i class="x"></i>
                  <i class="x"></i><i class="x"></i><i class="k"></i><i class="sd"></i><i class="sd"></i><i class="sd"></i><i class="sd"></i><i class="sd"></i><i class="sd"></i><i class="sd"></i><i class="sd"></i><i class="k"></i><i class="x"></i><i class="x"></i>
                  <i class="x"></i><i class="k"></i><i class="j"></i><i class="j"></i><i class="c"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="c"></i><i class="j"></i><i class="j"></i><i class="k"></i><i class="x"></i>
                  <i class="k"></i><i class="j"></i><i class="j"></i><i class="j"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="j"></i><i class="j"></i><i class="j"></i><i class="k"></i>
                  <i class="k"></i><i class="j"></i><i class="jd"></i><i class="j"></i><i class="w"></i><i class="c"></i><i class="c"></i><i class="c"></i><i class="c"></i><i class="w"></i><i class="j"></i><i class="jd"></i><i class="j"></i><i class="k"></i>
                  <i class="k"></i><i class="j"></i><i class="jd"></i><i class="j"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="j"></i><i class="jd"></i><i class="j"></i><i class="k"></i>
                  <i class="k"></i><i class="j"></i><i class="jd"></i><i class="j"></i><i class="j"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="w"></i><i class="j"></i><i class="j"></i><i class="jd"></i><i class="j"></i><i class="k"></i>
                  <i class="x"></i><i class="k"></i><i class="j"></i><i class="j"></i><i class="k"></i><i class="x"></i><i class="x"></i><i class="x"></i><i class="x"></i><i class="k"></i><i class="j"></i><i class="j"></i><i class="k"></i><i class="x"></i>
                  <i class="x"></i><i class="k"></i><i class="k"></i><i class="k"></i><i class="x"></i><i class="x"></i><i class="x"></i><i class="x"></i><i class="x"></i><i class="x"></i><i class="k"></i><i class="k"></i><i class="k"></i><i class="x"></i>
                </div>
              </div>
            </div>
          </div>

          <div class="scroll-cue"><span class="mouse"></span> SCROLL PARA ZARPAR</div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 2. EXPERIENCE                                                 -->
    <!-- ============================================================ -->
    <section class="screen" id="experiencia">
      <div class="shell">
        <div class="sec-intro">
          <span class="eyebrow"><span class="n">02</span> · LEVEL UP</span>
          <h2>EXPERIENCIA</h2>
          <span class="lead">Mi bitácora de roles, embarcado puerto a puerto.</span>
        </div>

        <div class="logbook riveted">
          <span class="rivet tl"></span><span class="rivet tr"></span>
          <span class="rivet bl"></span><span class="rivet br"></span>
          <div class="logbook-head">
            <h3>SHIP'S LOG</h3>
            <div class="filter">
              <span class="on">ALL · {experience.length.toString().padStart(2, '0')}</span>
              <span>ACTIVE · {activeCount.toString().padStart(2, '0')}</span>
              <span>CLEARED · {clearedCount.toString().padStart(2, '0')}</span>
            </div>
          </div>

          <div class="log-list">
            {experience.map((entry) => (
              <div class:list={['log-row', entry.status === 'active' ? 'active' : '']}>
                <div class="lvl">{entry.lvl}</div>
                <div class="role">
                  {entry.role}
                  <small>{entry.subrole}</small>
                </div>
                <div class="company">{entry.company}</div>
                <div class="dates">{entry.dates}</div>
                <div class:list={['status', entry.status === 'done' ? 'done' : '', entry.status === 'archive' ? 'archive' : '']}>
                  {statusLabel[entry.status] ?? entry.status}
                </div>
              </div>
            ))}
          </div>

          <div class="depth">
            <span class="lab"><span class="led-dot sea"></span> DEPTH</span>
            <div class="bar"></div>
            <span class="num">8 200 / 10 000 ▲ LVL 9</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 3. PROJECTS                                                   -->
    <!-- ============================================================ -->
    <section class="screen" id="proyectos">
      <div class="shell">
        <div class="sec-intro">
          <span class="eyebrow"><span class="n">03</span> · CARGO HOLD</span>
          <h2>PROYECTOS</h2>
          <span class="lead">Toca un manifiesto para abrir su bitácora completa.</span>
        </div>

        <div class="cargo riveted">
          <span class="rivet tl"></span><span class="rivet tr"></span>
          <span class="rivet bl"></span><span class="rivet br"></span>
          <div class="cargo-grid">
            {projects.map((proj) => (
              <button class="manifest" data-proj={proj.id}>
                <div class="emblem" style={proj.emblemStyle || ''}>
                  <span class="ring"></span>
                  <span class="tagno">CARGO·{proj.no}</span>
                </div>
                <div class="body">
                  <div class="kicker">
                    {proj.kicker} <span class="yr">· {proj.year}</span>
                  </div>
                  <h4>{proj.title}</h4>
                  <p class="one">{proj.oneliner}</p>
                  <div class="foot">
                    <div class="chips">
                      {proj.stack.slice(0, 3).map(([name, cls]) => (
                        <span class:list={['chip', cls]}>{name}</span>
                      ))}
                    </div>
                    <span class="open">VER ▸</span>
                  </div>
                </div>
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 4. ABOUT ME                                                   -->
    <!-- ============================================================ -->
    <section class="screen" id="about">
      <div class="shell">
        <div class="sec-intro">
          <span class="eyebrow"><span class="n">04</span> · CAPTAIN'S BIO</span>
          <h2>SOBRE MÍ</h2>
          <span class="lead">Quién maneja el timón.</span>
        </div>

        <div class="about-grid">
          <div class="about-portrait riveted">
            <span class="rivet tl"></span><span class="rivet tr"></span>
            <span class="rivet bl"></span><span class="rivet br"></span>
            <div class="frame">
              <div class="ph">[ DROP ZONE ]<br>FOTO<br>RETRATO</div>
            </div>
            <div class="yrs"><b>{about.years}</b>AÑOS<br>A BORDO</div>
          </div>
          <div class="about-card">
            <p class="hi" set:html={about.hi}></p>
            <p>{about.bio1}</p>
            <p>{about.bio2}</p>
            <div class="skills">
              {about.skills.map(([name, cls]) => (
                <span class:list={['chip', cls]}>{name}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 5. CONTACT                                                    -->
    <!-- ============================================================ -->
    <section class="screen contact-screen" id="contacto">
      <div class="shell">
        <div class="sec-intro">
          <span class="eyebrow"><span class="n">05</span> · DROP ANCHOR</span>
          <h2>CONTACTO</h2>
        </div>

        <p class="big-call" set:html={contact.bigCall}></p>

        <div class="anchor riveted">
          <span class="rivet tl"></span><span class="rivet tr"></span>
          <span class="rivet bl"></span><span class="rivet br"></span>
          <div class="big">DROP ANCHOR</div>
          <div class="prompt">¿TRABAJAMOS JUNTOS?</div>
          <div class="reg">⚙ ping sebastian — awaiting handshake · 0xC0FFEE ⚙</div>

          <div class="links">
            <a class="link gh" href={contact.githubUrl} target="_blank" rel="noopener">
              <div class="icn"></div>
              <h5>GITHUB</h5>
              <p>{contact.githubLabel}</p>
            </a>
            <a class="link li" href={contact.linkedinUrl} target="_blank" rel="noopener">
              <div class="icn"></div>
              <h5>LINKEDIN</h5>
              <p>{contact.linkedinLabel}</p>
            </a>
            <a class="link ml" href={`mailto:${contact.email}`}>
              <div class="icn"></div>
              <h5>EMAIL</h5>
              <p>{contact.email}</p>
            </a>
          </div>

          <div style="display:flex;justify-content:center;gap:14px;flex-wrap:wrap;">
            <a href={`mailto:${contact.email}`} class="pxbtn">▶ ENVIAR MENSAJE</a>
            <a href={`tel:${contact.phone.replace(/[\s-]/g, '')}`} class="pxbtn ghost">[ {contact.phone} ]</a>
          </div>

          <div class="footer-bar">
            <span set:html={contact.footerLeft}></span>
            <span set:html={contact.footerRight}></span>
          </div>
        </div>
      </div>
    </section>

    <div class="site-foot">© 2026 — JUAN SEBASTIÁN ARBOLEDA T. &nbsp;·&nbsp; <b>MEDELLÍN, COLOMBIA</b></div>

  </main>

  <!-- ============ PROJECT SHEET ============ -->
  <div class="sheet-backdrop" id="sheet-backdrop"></div>
  <div class="sheet" id="proj-sheet" role="dialog" aria-modal="true" aria-label="Detalle del proyecto"></div>

  <script type="application/json" id="portfolio-data" is:inline set:html={JSON.stringify({ projects })} />
  <script src="/portfolio.js" is:inline></script>
</Layout>
