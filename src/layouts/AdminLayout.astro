---
import '../styles/admin.css';
interface Props {
  title?: string;
  section?: string;
  breadcrumb?: string;
}
const { title = 'Admin', section = '', breadcrumb = '' } = Astro.props;
const path = Astro.url.pathname;

function isActive(href: string) {
  return path === href || path.startsWith(href + '/');
}
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title} — Admin · Sbas Portfolio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="adm-wrap">
    <!-- SIDEBAR -->
    <aside class="adm-sidebar">
      <div class="adm-sidebar-logo">
        <div class="wordmark">⚓ SBAS.DEV</div>
        <div class="sub">// admin panel v1.0</div>
      </div>

      <nav class="adm-nav">
        <div class="adm-nav-section">NAVIGATION</div>
        <a href="/admin" class:list={['adm-nav-link', { active: path === '/admin' }]}>
          <span class="dot brass"></span> DASHBOARD
        </a>

        <div class="adm-nav-section">CONTENT</div>
        <a href="/admin/projects" class:list={['adm-nav-link', { active: isActive('/admin/projects') }]}>
          <span class="dot sea"></span> PROYECTOS
        </a>
        <a href="/admin/experience" class:list={['adm-nav-link', { active: isActive('/admin/experience') }]}>
          <span class="dot led"></span> EXPERIENCIA
        </a>
        <a href="/admin/about" class:list={['adm-nav-link', { active: isActive('/admin/about') }]}>
          <span class="dot brass"></span> SOBRE MÍ
        </a>
        <a href="/admin/contact" class:list={['adm-nav-link', { active: isActive('/admin/contact') }]}>
          <span class="dot coral"></span> CONTACTO
        </a>

        <div class="adm-nav-section">SITE</div>
        <a href="/" target="_blank" class="adm-nav-link">
          <span class="dot coral"></span> VER PORTFOLIO ↗
        </a>
      </nav>

      <div class="adm-sidebar-footer">
        © 2026 SBAS.DEV &nbsp;·&nbsp; MADE IN MDE
      </div>
    </aside>

    <!-- MAIN -->
    <div class="adm-main">
      <div class="adm-topbar">
        <div class="crumb">
          ADMIN <span>›</span> {section}{breadcrumb ? <span aria-hidden="true"> › </span> : ''}{breadcrumb}
        </div>
        <div class="actions">
          <form method="POST" action="/admin/logout" style="margin:0">
            <button type="submit" class="adm-btn ghost sm">LOGOUT</button>
          </form>
        </div>
      </div>

      <main class="adm-content">
        <slot />
      </main>
    </div>
  </div>
</body>
</html>
